# ===========================================================
# Backend environment variables (copy to .env for local dev)
# ===========================================================

# ---- Project ----
PROJECT_NAME=Enterprise Print Tracking System
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api

# ---- Database ----
# Local development (SQLite, no setup needed):
DATABASE_URL=sqlite:///./print_tracking.db
# Production / Neon Postgres example:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DB?sslmode=require

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# ---- JWT (admin auth) ----
# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=please-replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- Print-agent ingestion API key ----
# Used by the on-premise Windows print-agent to authenticate to /api/print-log.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_API_KEY=please-replace-with-a-long-random-string

# ---- Default admin (auto-seeded if no admin exists) ----
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@printtracking.local
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_FULL_NAME=System Administrator

# ---- CORS ----
# Comma-separated list. Use "*" only for local dev.
CORS_ORIGINS=*

# ---- Office printer defaults ----
DEFAULT_PRINTER_NAME=HP Smart Tank 660-670 series
DEFAULT_PRINTER_IP=192.168.1.131
DEFAULT_PRINTER_NETWORK=CKP_WSPACE
